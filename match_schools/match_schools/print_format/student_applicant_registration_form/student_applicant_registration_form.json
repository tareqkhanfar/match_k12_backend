 "font_size": 0,
 "html": "<div class=\"sr-print\" dir=\"rtl\">\n<style>\n\t@page { size: A4; margin: 10mm 8mm; }\n\t.sr-print * { box-sizing: border-box; font-family: 'Cairo', sans-serif; }\n\t.sr-print { font-size: 12px; color: #222; direction: rtl; text-align: right; line-height: 1.15; }\n\n\t.sr-header { text-align: center; margin-bottom: 3mm; padding: 2mm 0; border-bottom: 2px solid #2c3e50; }\n\t.sr-company { font-size: 18px; font-weight: 700; color: #2c3e50; margin-bottom: 1mm; }\n\t.sr-company-meta { font-size: 10px; font-weight: 600; color: #555; margin-bottom: 2mm; }\n\t.sr-title { font-size: 15px; font-weight: 700; margin: 2mm 0 0; padding: 2mm; background-color: #f0f0f0; border: 1.5px solid #2c3e50; }\n\n\t.sr-meta-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2mm; margin: 3mm 0; }\n\t.sr-meta-box { padding: 2mm; border-bottom: 1px solid #ccc; }\n\t.sr-meta-label { font-weight: 700; color: #555; font-size: 10px; margin-bottom: 1mm; }\n\t.sr-meta-value { font-weight: 600; font-size: 12px; color: #2c3e50; }\n\n\t.sr-section { margin: 3mm 0; border: 2px solid #2c3e50; }\n\t.sr-section-title { font-size: 13px; font-weight: 700; padding: 2mm; background-color: #2c3e50; color: #fff; text-align: center; }\n\t.sr-table { width: 100%; border-collapse: collapse; font-size: 11.5px; }\n\t.sr-table td, .sr-table th { padding: 2mm; border: 1px solid #999; vertical-align: middle; }\n\t.sr-table td.k { font-weight: 700; color: #555; background-color: #f4f6f8; width: 25%; white-space: nowrap; }\n\t.sr-table td.v { font-weight: 600; color: #2c3e50; }\n\t.sr-table tbody tr:nth-child(even) td.v { background-color: #fafafa; }\n\t.sr-table th { background-color: #f4f6f8; font-weight: 700; color: #555; font-size: 11px; }\n\n\t.sr-status { display: inline-block; padding: 1mm 4mm; border-radius: 3px; font-weight: 700; font-size: 11px; }\n\t.sr-status-applied  { background: #e3f2fd; color: #1565c0; }\n\t.sr-status-approved { background: #e8f5e9; color: #28a745; }\n\t.sr-status-rejected { background: #fdecea; color: #c0392b; }\n\t.sr-status-admitted { background: #ede7f6; color: #5e35b1; }\n\n\t.sr-decl { margin: 4mm 0; padding: 3mm; background-color: #e3f2fd; border: 2px solid #2196f3; border-radius: 2mm; font-size: 11px; font-weight: 600; color: #1565c0; line-height: 1.5; }\n\n\t.sr-signatures { display: flex; justify-content: space-between; margin-top: 12mm; gap: 6mm; }\n\t.sr-sig { text-align: center; width: 45%; padding-top: 5mm; border-top: 1px solid #999; }\n\t.sr-sig-label { font-weight: 700; font-size: 11px; }\n\t.sr-sig-line { margin-top: 4mm; font-size: 11px; color: #444; text-align: right; }\n\n\t.sr-footer { text-align: center; font-size: 10px; color: #777; padding-top: 2mm; margin-top: 4mm; border-top: 1px solid #ccc; }\n\n\t@media print {\n\t\t.sr-print .sr-section-title { background-color: #2c3e50 !important; color: #fff !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }\n\t\t.sr-print .sr-table td.k, .sr-print .sr-table th { background-color: #f4f6f8 !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }\n\t\t.sr-print .sr-decl { background-color: #e3f2fd !important; border: 2px solid #2196f3 !important; }\n\t}\n</style>\n\n<div class=\"sr-header\">\n\t{% if letter_head %}{{ letter_head }}{% endif %}\n\t<div class=\"sr-company-meta\">نموذج تسجيل طالب / Student Registration Form</div>\n\t<div class=\"sr-title\">طلب تسجيل طالب</div>\n</div>\n\n<div class=\"sr-meta-grid\">\n\t<div class=\"sr-meta-box\">\n\t\t<div class=\"sr-meta-label\">رقم الطلب / Application No.</div>\n\t\t<div class=\"sr-meta-value\">{{ doc.name }}</div>\n\t</div>\n\t<div class=\"sr-meta-box\">\n\t\t<div class=\"sr-meta-label\">تاريخ الطلب / Date</div>\n\t\t<div class=\"sr-meta-value\">{{ frappe.utils.formatdate(doc.application_date or doc.creation) }}</div>\n\t</div>\n\t<div class=\"sr-meta-box\">\n\t\t<div class=\"sr-meta-label\">الحالة / Status</div>\n\t\t<div class=\"sr-meta-value\">\n\t\t\t{% set st = doc.application_status or \"Applied\" %}\n\t\t\t{% if st == \"Applied\" %}<span class=\"sr-status sr-status-applied\">مقدَّم / Applied</span>\n\t\t\t{% elif st == \"Approved\" %}<span class=\"sr-status sr-status-approved\">مقبول / Approved</span>\n\t\t\t{% elif st == \"Rejected\" %}<span class=\"sr-status sr-status-rejected\">مرفوض / Rejected</span>\n\t\t\t{% elif st == \"Admitted\" %}<span class=\"sr-status sr-status-admitted\">مُلتحق / Admitted</span>\n\t\t\t{% else %}{{ st }}{% endif %}\n\t\t</div>\n\t</div>\n</div>\n\n<div class=\"sr-section\">\n\t<div class=\"sr-section-title\">بيانات الطالب / Student Information</div>\n\t<table class=\"sr-table\">\n\t\t<tbody>\n\t\t\t<tr>\n\t\t\t\t<td class=\"k\">الاسم الأول / First Name</td><td class=\"v\">{{ doc.first_name or \"\" }}</td>\n\t\t\t\t<td class=\"k\">اسم الأب / Father's Name</td><td class=\"v\">{{ doc.middle_name or \"\" }}</td>\n\t\t\t</tr>\n\t\t\t<tr>\n\t\t\t\t<td class=\"k\">اسم الجد / Grandfather's Name</td><td class=\"v\">{{ doc.get(\"ms_grandfather_name\") or \"\" }}</td>\n\t\t\t\t<td class=\"k\">اسم العائلة / Last Name</td><td class=\"v\">{{ doc.last_name or \"\" }}</td>\n\t\t\t</tr>\n\t\t\t<tr>\n\t\t\t\t<td class=\"k\">رقم الهوية / ID Number</td><td class=\"v\">{{ doc.get(\"ms_id_number\") or \"\" }}</td>\n\t\t\t\t<td class=\"k\">تاريخ الميلاد / Date of Birth</td><td class=\"v\">{{ frappe.utils.formatdate(doc.date_of_birth) if doc.date_of_birth else \"\" }}</td>\n\t\t\t</tr>\n\t\t\t<tr>\n\t\t\t\t<td class=\"k\">الجنس / Gender</td><td class=\"v\">{{ doc.gender or \"\" }}</td>\n\t\t\t\t<td class=\"k\">الجنسية / Nationality</td><td class=\"v\">{{ doc.nationality or \"\" }}</td>\n\t\t\t</tr>\n\t\t\t<tr>\n\t\t\t\t<td class=\"k\">الصف المطلوب / Program</td><td class=\"v\">{{ doc.program or \"\" }}</td>\n\t\t\t\t<td class=\"k\">فئة الطالب / Category</td><td class=\"v\">{{ doc.student_category or \"\" }}</td>\n\t\t\t</tr>\n\t\t\t<tr>\n\t\t\t\t<td class=\"k\">العام الدراسي / Academic Year</td><td class=\"v\">{{ doc.academic_year or \"\" }}</td>\n\t\t\t\t<td class=\"k\">الفصل الدراسي / Academic Term</td><td class=\"v\">{{ doc.academic_term or \"\" }}</td>\n\t\t\t</tr>\n\t\t\t<tr>\n\t\t\t\t<td class=\"k\">رقم الجوال / Mobile</td><td class=\"v\">{{ doc.student_mobile_number or \"\" }}</td>\n\t\t\t\t<td class=\"k\">البريد الإلكتروني / Email</td><td class=\"v\">{{ doc.student_email_id or \"-\" }}</td>\n\t\t\t</tr>\n\t\t\t<tr>\n\t\t\t\t<td class=\"k\">العنوان السكني / Address</td>\n\t\t\t\t<td class=\"v\" colspan=\"3\">\n\t\t\t\t\t{{ [doc.address_line_1, doc.address_line_2, doc.city, doc.state, doc.country] | select | join(\"، \") }}\n\t\t\t\t</td>\n\t\t\t</tr>\n\t\t</tbody>\n\t</table>\n</div>\n\n<div class=\"sr-section\">\n\t<div class=\"sr-section-title\">بيانات أولياء الأمور / Guardian Information</div>\n\t<table class=\"sr-table\">\n\t\t<thead>\n\t\t\t<tr>\n\t\t\t\t<th style=\"width: 28%;\">الاسم / Name</th>\n\t\t\t\t<th style=\"width: 18%;\">صلة القرابة / Relation</th>\n\t\t\t\t<th style=\"width: 18%;\">رقم الجوال / Mobile</th>\n\t\t\t\t<th style=\"width: 18%;\">المهنة / Occupation</th>\n\t\t\t\t<th style=\"width: 18%;\">البريد / Email</th>\n\t\t\t</tr>\n\t\t</thead>\n\t\t<tbody>\n\t\t\t{%- if doc.guardians -%}\n\t\t\t\t{%- for row in doc.guardians -%}\n\t\t\t\t\t{%- set g = frappe.db.get_value(\"Guardian\", row.guardian,\n\t\t\t\t\t\t[\"guardian_name\", \"mobile_number\", \"occupation\", \"email_address\"],\n\t\t\t\t\t\tas_dict=True) if row.guardian else None -%}\n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<td class=\"v\">{{ row.guardian_name or (g.guardian_name if g else \"\") }}</td>\n\t\t\t\t\t\t<td class=\"v\">{{ row.relation or \"\" }}</td>\n\t\t\t\t\t\t<td class=\"v\">{{ g.mobile_number if g else \"\" }}</td>\n\t\t\t\t\t\t<td class=\"v\">{{ g.occupation if g else \"\" }}</td>\n\t\t\t\t\t\t<td class=\"v\">{{ g.email_address if g else \"\" }}</td>\n\t\t\t\t\t</tr>\n\t\t\t\t{%- endfor -%}\n\t\t\t{%- else -%}\n\t\t\t\t<tr><td class=\"v\" colspan=\"5\">—</td></tr>\n\t\t\t{%- endif -%}\n\t\t</tbody>\n\t</table>\n</div>\n\n{%- if doc.siblings -%}\n<div class=\"sr-section\">\n\t<div class=\"sr-section-title\">الإخوة في المدرسة / Siblings</div>\n\t<table class=\"sr-table\">\n\t\t<tbody>\n\t\t\t{%- for row in doc.siblings -%}\n\t\t\t<tr>\n\t\t\t\t<td class=\"k\">{{ row.get(\"full_name\") or \"\" }}</td>\n\t\t\t\t<td class=\"v\">{{ row.get(\"program\") or row.get(\"institution\") or \"\" }}</td>\n\t\t\t\t<td class=\"k\">{{ \"يدرس في المدرسة\" if row.get(\"studying_in_same_institute\") == \"YES\" else \"خارج المدرسة\" }}</td>\n\t\t\t\t<td class=\"v\">{{ row.get(\"gender\") or \"\" }}</td>\n\t\t\t</tr>\n\t\t\t{%- endfor -%}\n\t\t</tbody>\n\t</table>\n</div>\n{%- endif -%}\n\n<div class=\"sr-decl\">\n\tأقر أنا ولي أمر الطالب بأن جميع البيانات الواردة في هذا النموذج صحيحة وكاملة، وأتحمل المسؤولية القانونية عن صحتها. كما أوافق على سياسات وأنظمة المؤسسة التعليمية المعمول بها.\n</div>\n\n<div class=\"sr-signatures\">\n\t<div class=\"sr-sig\">\n\t\t<div class=\"sr-sig-label\">توقيع ولي الأمر / Parent Signature</div>\n\t\t<div class=\"sr-sig-line\">الاسم / Name: ____________________</div>\n\t\t<div class=\"sr-sig-line\">التاريخ / Date: ____________</div>\n\t</div>\n\t<div class=\"sr-sig\">\n\t\t<div class=\"sr-sig-label\">موظف التسجيل / Registration Officer</div>\n\t\t<div class=\"sr-sig-line\">الاسم / Name: ____________________</div>\n\t\t<div class=\"sr-sig-line\">التاريخ / Date: ____________</div>\n\t</div>\n</div>\n\n<div class=\"sr-footer\">\n\t{% if footer %}{{ footer }}{% endif %}\n</div>\n\n</div>\n",
 "idx": 0,
